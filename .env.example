# ─────────────────────────────────────────────────────────────────────────────
#  EduQuiz — variables d'environnement (exemple)
#
#  Copier ce fichier en `.env` à la racine du repo, puis ajuster au besoin.
#  Les valeurs par défaut correspondent à la stack `docker-compose.dev.yml`
#  d'`infra/docker/` et fonctionnent out-of-the-box pour le développement
#  local.
#
#  ⚠  Ce fichier est commité dans git. `.env` (la copie locale) ne l'est PAS.
#  ⚠  Ne jamais mettre de vrais secrets dans `.env.example`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres (image docker-compose.dev.yml) ──────────────────────────────────
POSTGRES_USER=eduquiz
POSTGRES_PASSWORD=eduquiz
POSTGRES_DB=eduquiz

# ── Prisma ──────────────────────────────────────────────────────────────────
#  DATABASE_URL = URL consommée par le runtime (avec pooler en prod, connexion
#  directe en dev).
#  DIRECT_URL   = URL utilisée pour les migrations et `prisma db push` ; en
#                 prod elle doit contourner le pooler (PgBouncer).
#  En dev, les deux pointent sur la même instance locale.
DATABASE_URL=postgresql://eduquiz:eduquiz@localhost:5432/eduquiz?schema=public
DIRECT_URL=postgresql://eduquiz:eduquiz@localhost:5432/eduquiz?schema=public

# ── Redis (rate-limit, cache) ───────────────────────────────────────────────
#  Optionnel : si vide ou absent, le rate-limit bascule en mode no-op
#  (toutes les requêtes passent). Pratique pour le dev local sans Redis monté.
REDIS_URL=redis://localhost:6379

# ── Observabilité ───────────────────────────────────────────────────────────
#  LOG_LEVEL : niveau du logger structuré JSON (debug | info | warn | error).
#              Défaut : info en dev, warn en prod.
LOG_LEVEL=info

# ── Auth.js v5 ──────────────────────────────────────────────────────────────
#  AUTH_SECRET : 32+ octets aléatoires. Générer avec : openssl rand -base64 33
#               Validé au boot par packages/auth/src/env.ts (refus si < 32 char).
AUTH_SECRET=fj8UpmXbEz5usIOuGtrsXv9xjAu1g3O7s4+9AhwVhQa/
AUTH_URL=http://localhost:3000
#  AUTH_TRUST_HOST : true derrière un reverse proxy (Traefik, Nginx)
#                    qui termine TLS. Toujours true en dev derrière Docker.
AUTH_TRUST_HOST=true
#  AUTH_DEBUG : verbose Auth.js en console. Jamais activer en prod.
AUTH_DEBUG=false
#  Fournisseurs OAuth (laisser vides en dev si non utilisés ; Auth.js
#  désactivera automatiquement les providers dont les credentials manquent).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# ── SMTP (MailHog en dev, SendGrid/Postmark en prod) ────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="EduQuiz <no-reply@eduquiz.local>"
SMTP_SECURE=false

# ── Stockage objet (MinIO en dev, S3 en prod) ───────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eduquiz-dev
S3_ACCESS_KEY=eduquiz
S3_SECRET_KEY=eduquiz-minio-dev
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=eduquiz
MINIO_ROOT_PASSWORD=eduquiz-minio-dev

# ── Stripe (paiements) ──────────────────────────────────────────────────────
#  En dev on peut laisser vide et utiliser le mode test Stripe via
#  `stripe listen --forward-to localhost:3000/api/stripe/webhook` pour
#  obtenir un STRIPE_WEBHOOK_SECRET de test.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_FAMILY_MONTHLY=

# ── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=fr-CA
NEXT_PUBLIC_SUPPORTED_LOCALES=fr-CA,en-CA

# ── Observabilité (optionnel en dev) ────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Cron interne (jobs planifiés) ───────────────────────────────────────────
#  PURGE_ACCOUNTS_SECRET : secret partagé entre le timer systemd Proxmox et
#  l'endpoint `/api/cron/purge-accounts`. Générer avec : openssl rand -base64 33
#  L'endpoint retourne 500 si cette variable est absente ou vide.
#  En dev la purge peut être déclenchée manuel