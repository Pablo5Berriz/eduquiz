# Enforce LF line endings for all text files across OSes.
* text=auto eol=lf

# Binary files — never diff, never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.mp4 binary
*.zip binary
*.gz binary
