{
  "name": "@eduquiz/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Application mobile Expo SDK 52 d'EduQuiz (iOS et Android, parcours apprenant et parent).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "echo \"[@eduquiz/mobile] build — EAS Build configuré à l'étape 2.x\" && exit 0",
    "lint": "eslint src babel.config.js metro.config.js eslint.config.mjs --max-warnings=0",
    "test": "echo \"[@eduquiz/mobile] test — Jest + React Native Testing Library à venir (étape 1.x)\" && exit 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf .expo .turbo node_modules"
  },
  "dependencies": {
    "@eduquiz/i18n": "workspace:*",
    "@eduquiz/ui": "workspace:*",
    "@eduquiz/utils": "workspace:*",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.3",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eduquiz/config": "workspace:*",
    "@types/react": "~18.3.12",
    "typescript": "^5.6.3"
  }
}
