{
  "expo": {
    "name": "EduQuiz",
    "slug": "eduquiz",
    "scheme": "eduquiz",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eduquiz.app"
    },
    "android": {
      "package": "com.eduquiz.app",
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
