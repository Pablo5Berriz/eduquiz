{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@eduquiz/config/tsconfig-expo",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", ".expo", ".turbo", "dist"]
}
