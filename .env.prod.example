# ─────────────────────────────────────────────────────────────────────────────
#  EduQuiz — variables d'environnement PRODUCTION (exemple)
#
#  ⚠  Ce fichier est commité dans git pour documenter les variables requises.
#  ⚠  La copie réelle `.env.prod` NE DOIT JAMAIS être commitée.
#  ⚠  Tous les secrets ci-dessous sont des PLACEHOLDERS — remplacer avant
#     démarrage de la pile prod. Utiliser `openssl rand -base64 32` pour
#     générer des valeurs fortes.
#
#  Cibles : `docker compose --env-file .env.prod -f infra/docker/docker-compose.prod.yml up -d`
# ─────────────────────────────────────────────────────────────────────────────

# ── Domaine & TLS ───────────────────────────────────────────────────────────
# Domaine principal sur lequel Traefik exposera l'application.
APP_DOMAIN=eduquiz.ca
# Email utilisé par Let's Encrypt pour les notifications de renouvellement
# et les urgences de révocation.
TRAEFIK_ACME_EMAIL=ops@eduquiz.ca

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=eduquiz
POSTGRES_PASSWORD=__CHANGE_ME_STRONG_RANDOM_32__
POSTGRES_DB=eduquiz

# ── Prisma ──────────────────────────────────────────────────────────────────
# En prod, les deux URLs passent par le réseau privé Docker (hostname interne
# `postgres`). DATABASE_URL passera par un pooler (PgBouncer) quand il sera
# ajouté — pour l'instant les deux pointent sur la même instance.
DATABASE_URL=postgresql://eduquiz:__CHANGE_ME_STRONG_RANDOM_32__@postgres:5432/eduquiz?schema=public
DIRECT_URL=postgresql://eduquiz:__CHANGE_ME_STRONG_RANDOM_32__@postgres:5432/eduquiz?schema=public

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=__CHANGE_ME_STRONG_RANDOM_32__
REDIS_URL=redis://:__CHANGE_ME_STRONG_RANDOM_32__@redis:6379

# ── Auth.js v5 ──────────────────────────────────────────────────────────────
# AUTH_SECRET : 32+ octets aléatoires. `openssl rand -base64 32`
AUTH_SECRET=__CHANGE_ME_AUTH_SECRET__
AUTH_URL=https://eduquiz.ca
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# ── SMTP (Resend / Postmark / SendGrid) ─────────────────────────────────────
# Pas de MailHog en prod. Utiliser un service transactionnel fiable.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=__CHANGE_ME_SMTP_API_KEY__
SMTP_FROM="EduQuiz <no-reply@eduquiz.ca>"
SMTP_SECURE=true

# ── MinIO (stockage objet local) ────────────────────────────────────────────
MINIO_ROOT_USER=eduquiz-prod
MINIO_ROOT_PASSWORD=__CHANGE_ME_STRONG_RANDOM_32__
# Désactivé par défaut en prod (pas d'UI publique). Mettre `on` temporairement
# pour les opérations manuelles via tunnel SSH.
MINIO_BROWSER=off

# ── S3 consommé par l'app ───────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=eduquiz
S3_ACCESS_KEY=eduquiz-prod
S3_SECRET_KEY=__CHANGE_ME_STRONG_RANDOM_32__
S3_FORCE_PATH_STYLE=true

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live___CHANGE_ME__
STRIPE_PUBLISHABLE_KEY=pk_live___CHANGE_ME__
STRIPE_WEBHOOK_SECRET=whsec___CHANGE_ME__
STRIPE_PRICE_PREMIUM_MONTHLY=price___CHANGE_ME__
STRIPE_PRICE_FAMILY_MONTHLY=price___CHANGE_ME__

# ── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://eduquiz.ca
NEXT_PUBLIC_DEFAULT_LOCALE=fr-CA
NEXT_PUBLIC_SUPPORTED_LOCALES=fr-CA,en-CA

# ── Observabilité ───────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Feature flags ───────────────────────────────────────────────────────────
FEATURE_PARENT_DASHBOARD=true
FEATURE_PUBLIC_CATALOG=true

# ── Backup off-site (Backblaze B2 — API S3-compatible) ──────────────────────
# Créer une "Application Key" B2 avec accès RW limité aux deux buckets
# ci-dessous uniquement. Ne JAMAIS utiliser le masterKey.
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_ACCESS_KEY=__CHANGE_ME_B2_KEY_ID__
B2_SECRET_KEY=__CHANGE_ME_B2_APPLICATION_KEY__
B2_BUCKET_POSTGRES=eduquiz-postgres-backup
B2_BUCKET_MINIO=eduquiz-minio-backup

# Clé publique age (recipient) pour chiffrer les dumps Postgres. Générer avec :
#   age-keygen -o age-key.txt
# Puis extraire la ligne `# public key:` et coller ici. La clé PRIVÉE reste
# HORS DU SERVEUR, sur un support contrôlé par l'opérateur (gestionnaire
# de mots de passe + copie physique chiffrée).
BACKUP_AGE_RECIPIENT=age1__CHANGE_ME_PUBLIC_KEY__

# Rétention locale (nombre de dumps récents gardés dans backup-tmp).
BACKUP_RETENTION_DAYS=7
