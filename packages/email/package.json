{
  "name": "@eduquiz/email",
  "version": "0.0.0",
  "private": true,
  "description": "Envoi d'emails transactionnels EduQuiz (vérification compte, bienvenue, reset password). nodemailer + templates HTML bilingues.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@eduquiz/i18n": "workspace:*",
    "nodemailer": "^6.9.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eduquiz/config": "workspace:*",
    "@types/nodemailer": "^6.4.17"
  }
}
