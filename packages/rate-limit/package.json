{
  "name": "@eduquiz/rate-limit",
  "version": "0.0.0",
  "private": true,
  "description": "Rate limiting fenêtre fixe basé sur Redis (ioredis), avec mode no-op en dev local sans Redis.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "ioredis": "^5.11.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eduquiz/config": "workspace:*"
  }
}
