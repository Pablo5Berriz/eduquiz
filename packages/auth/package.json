{
  "name": "@eduquiz/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Backbone Auth.js v5 d'EduQuiz : adapter Prisma, providers Credentials/Google/Apple, helpers serveur (rôles, mots de passe Argon2id, tokens de vérification).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./edge": "./src/edge.ts",
    "./env": "./src/env.ts",
    "./password": "./src/password.ts",
    "./permissions": "./src/permissions.ts",
    "./tokens": "./src/tokens.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@eduquiz/db": "workspace:*",
    "@eduquiz/i18n": "workspace:*",
    "@node-rs/argon2": "^2.1.0",
    "next-auth": "5.0.0-beta.25",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "next": "^14.2.18",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@eduquiz/config": "workspace:*"
  }
}
