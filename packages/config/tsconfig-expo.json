{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig-react.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "jsx": "react-native",
    "types": ["expo/tsconfig.base"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true
  }
}
