{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@eduquiz/config/tsconfig-library",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": ["node_modules", "dist", ".turbo", "**/*.test.ts"]
}
