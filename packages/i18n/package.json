{
  "name": "@eduquiz/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Traductions FR/EN partagées (UI, messages d'erreur, courriels transactionnels). Locale par défaut : FR.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fr": "./src/locales/fr.json",
    "./en": "./src/locales/en.json"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {},
  "devDependencies": {
    "@eduquiz/config": "workspace:*"
  }
}
