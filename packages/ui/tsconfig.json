{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@eduquiz/config/tsconfig-react",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", ".turbo", "**/*.test.ts", "**/*.test.tsx"]
}
